{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Solicitudes por segundo",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum by (handler) (rate(http_requests_total{job=\"kosmo-backend\",handler=~\"${handler:regex}\"}[5m]))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Tiempo de respuesta por ruta (p95)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"kosmo-backend\",handler=~\"${handler:regex}\"}[5m])))",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "description": "Tiempo estimado por debajo del cual se completó el 95 % de las solicitudes de cada ruta durante los últimos cinco minutos."
    },
    {
      "id": 4,
      "title": "Validaciones de código en curso",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "sum(kosmo_active_code_runners{job=\"kosmo-backend\"})",
          "legendFormat": "Ejecutores activos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "description": "Ejecutores activos en KOSMO Lite en cada recolección de Prometheus. Una validación que termine entre dos muestras puede no aparecer en la gráfica."
    },
    {
      "id": 5,
      "title": "Errores de la API en los últimos 15 minutos",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "(sum(increase(http_requests_total{job=\"kosmo-backend\",handler=~\"${handler:regex}\",status=~\"5..\"}[15m])) or (0 * sum(increase(http_requests_total{job=\"kosmo-backend\",handler=~\"${handler:regex}\"}[15m])))) and on() (min(up{job=\"kosmo-backend\"}) == 1)",
          "legendFormat": "Errores 5xx",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Estimación de respuestas HTTP 5xx para las rutas seleccionadas durante los 15 minutos anteriores al final del intervalo. Sin muestras suficientes, el panel queda sin datos.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Registros del backend",
      "type": "logs",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          },
          "expr": "{service=\"kosmo-backend\"}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^Prometheus$/",
        "hide": 2,
        "refresh": 1,
        "skipUrlSync": true
      },
      {
        "name": "ds_loki",
        "type": "datasource",
        "query": "loki",
        "regex": "/^Loki$/",
        "hide": 2,
        "refresh": 1,
        "skipUrlSync": true
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_prom}"
        },
        "definition": "label_values(http_requests_total{job=\"kosmo-backend\"}, handler)",
        "includeAll": true,
        "multi": true,
        "name": "handler",
        "options": [],
        "query": {
          "query": "label_values(http_requests_total{job=\"kosmo-backend\"}, handler)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query",
        "label": "Ruta de la API",
        "allValue": ".*"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Actividad de la API",
  "uid": "kosmo-overview-agentes",
  "tags": [
    "api"
  ],
  "schemaVersion": 38,
  "refresh": "15s"
}
