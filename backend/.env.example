# ==============================================================================
# SEGURIDAD: PLANTILLA DE CONFIGURACIÓN (.env.example)
# NUNCA coloques credenciales reales ni secretos de producción en este archivo
# ni en tu archivo .env local. Los archivos .env están excluidos en .gitignore.
# En Staging/Producción utiliza un gestor de secretos (Vault, Doppler, AWS SSM).
# Para generar FERNET_MASTER_KEY en dev:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ==============================================================================

# Entorno y servidor
ENV=development
LOG_LEVEL=DEBUG
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base de datos y caché
DATABASE_URL=postgresql+asyncpg://kosmo:kosmo@localhost:5432/kosmo_dev
# Redis requiere autenticación (conforme a VULN-016): redis://:password@host:port/db
REDIS_URL=redis://:kosmo_redis_dev@localhost:6379/0

# Capacidad y concurrencia (mínimo 50 usuarios concurrentes BYOK)
DB_POOL_SIZE=60
DB_MAX_OVERFLOW=40
REDIS_MAX_CONNECTIONS=150
LLM_MAX_CONCURRENCY=100
WORKERS=2

# Seguridad y tokens
FERNET_MASTER_KEY=
JWT_PRIVATE_KEY_PATH=./.secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./.secrets/jwt_public.pem
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ALGORITHM=RS256
JWT_ISSUER=kosmo
JWT_AUDIENCE=kosmo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
AUTH_DISABLED=false

# Integraciones OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=

# Configuración de LLM del sistema
LLM_PROVIDER=noop
LLM_MODEL=noop
LLM_API_KEY=
EMBEDDING_PROVIDER=auto

# Generación de código y workspaces
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=deepseek/deepseek-flash
# Staging/producción usan el lanzador aislado y las credenciales personales.
# OPENCODE_LAUNCHER_BASE_URL=http://opencode-launcher:8082
# OPENCODE_LAUNCHER_TOKEN=<token-interno-distinto-al-del-runner>
KOSMO_WORKSPACES_DIR=./workspaces
KOSMO_MCP_BASE_URL=http://127.0.0.1:8000/mcp

# Ejecución remota de código y túneles de preview
CODE_RUNNER_BASE_URL=
CODE_RUNNER_TOKEN=
PREVIEW_PUBLIC_HOST_SUFFIX=
CLOUDFLARE_PREVIEW_API_TOKEN=
CLOUDFLARE_PREVIEW_ACCOUNT_ID=
CLOUDFLARE_PREVIEW_ZONE_ID=
CLOUDFLARE_PREVIEW_TUNNEL_ID=

# Telemetría y observabilidad
LOGFIRE_TOKEN=
OTEL_SERVICE_NAME=kosmo-backend
OTEL_ENVIRONMENT=development