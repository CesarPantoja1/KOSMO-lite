# ==============================================================================
# SEGURIDAD: PLANTILLA DE CONFIGURACIÓN FRONTEND (.env.example)
# NUNCA expongas claves privadas ni secretos en variables NEXT_PUBLIC_*
# ni guardes secretos en archivos locales rastreados.
# ==============================================================================

# Configuración del Frontend (Next.js)

# API y dominio
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DOMAIN_APP=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KOSMO
NEXT_PUBLIC_APP_ENV=development

# Entorno de desarrollo
NEXT_PUBLIC_AUTH_DISABLED=false
NEXT_PUBLIC_USE_MOCKS=false

# Integraciones OAuth
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_RAILWAY_CLIENT_ID=

